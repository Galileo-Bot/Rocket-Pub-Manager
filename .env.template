# Copy to .env and fill in the values.

AYFRI_ROCKETMANAGER_TOKEN=
AYFRI_ROCKETMANAGER_PREFIX=/
# `development` enables debug logging and verbose error responses.
AYFRI_ROCKETMANAGER_ENVIRONMENT=development

# Ads configuration
AYFRI_ROCKETMANAGER_AUTOMATIC_SANCTIONS=false
AYFRI_ROCKETMANAGER_AUTOMATIC_END_MESSAGE=false
AYFRI_ROCKETMANAGER_CHANNEL_SANCTION_ID=
AYFRI_ROCKETMANAGER_CHANNEL_VERIF_ID=
AYFRI_ROCKETMANAGER_CHANNEL_VERIF_LOGS_ID=

# Database
# SQLite file, created with its schema on first startup. Overridden by docker-compose.yml.
AYFRI_ROCKETMANAGER_DB_PATH=data/rocketmanager.db
